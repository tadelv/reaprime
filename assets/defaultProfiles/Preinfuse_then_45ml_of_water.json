{
  "version": "2",
  "title": "Preinfuse then 45ml of water",
  "author": "Decent",
  "notes": "Australian barista Matt Perger suggested this technique to us. The idea is to fully saturate your puck, and then squeeze the brewed coffee out using a calculated water volume.  This results in consistently brewed espresso without needing to use a scale.",
  "beverage_type": "espresso",
  "steps": [
    {
      "name": "preinfusion",
      "pump": "flow",
      "transition": "fast",
      "temperature": "90.0",
      "sensor": "coffee",
      "seconds": "25.0",
      "volume": "0.0",
      "weight": "0.0",
      "flow": "8.0",
      "pressure": "1.0",
      "exit": {
        "type": "pressure",
        "condition": "over",
        "value": "4.0"
      }
    },
    {
      "name": "hold",
      "pump": "flow",
      "transition": "fast",
      "temperature": "90.0",
      "sensor": "coffee",
      "seconds": "20.0",
      "volume": "0.0",
      "weight": "0.0",
      "flow": "2.0",
      "pressure": "0.0"
    },
    {
      "name": "decline",
      "pump": "flow",
      "transition": "smooth",
      "temperature": "90.0",
      "sensor": "coffee",
      "seconds": "0.0",
      "volume": "0.0",
      "weight": "0.0",
      "flow": "1.0",
      "pressure": "0.0"
    }
  ],
  "tank_temperature": "0.0",
  "target_weight": "36.0",
  "target_volume": "36.0",
  "target_volume_count_start": "1",
  "type": "flow",
  "hidden": "0"
}
